#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "${1:-}" = "--cli" ]; then
  shift
  exec "${SCRIPT_DIR}/manage-runners.sh" "$@"
fi

NODE_BIN="${RUNNERCTL_NODE_BIN:-}"

if [ -z "${NODE_BIN}" ] && command -v node >/dev/null 2>&1; then
  NODE_BIN="$(command -v node)"
fi

if [ -z "${NODE_BIN}" ]; then
  NODE_BIN="${SCRIPT_DIR}/host-tools/node24/bin/node"
fi

if [ ! -x "${NODE_BIN}" ]; then
  ARCHIVE_PATH="${RUNNER_ARCHIVE_PATH:-${SCRIPT_DIR}/actions-runner-osx-arm64-2.336.0.tar.gz}"
  if [ ! -f "${ARCHIVE_PATH}" ]; then
    echo "Node.js is unavailable and the bundled runner archive was not found: ${ARCHIVE_PATH}" >&2
    exit 1
  fi

  mkdir -p "${SCRIPT_DIR}/host-tools"
  TEMP_DIR="$(mktemp -d "${SCRIPT_DIR}/host-tools/.node24.XXXXXX")"
  trap 'rm -rf "${TEMP_DIR}"' EXIT
  tar -xzf "${ARCHIVE_PATH}" -C "${TEMP_DIR}" ./externals/node24/bin/node
  mkdir -p "$(dirname "${NODE_BIN}")"
  mv "${TEMP_DIR}/externals/node24/bin/node" "${NODE_BIN}"
  chmod u+x "${NODE_BIN}"
fi

METRICS_SOURCE="${SCRIPT_DIR}/runnerctl-app/native/runnerctl-procstats.c"
METRICS_BIN="${RUNNER_PROCSTATS_BIN:-${SCRIPT_DIR}/host-tools/runnerctl-procstats}"

if [ -z "${RUNNER_PROCSTATS_BIN:-}" ] &&
   [ "$(uname -s)" = "Darwin" ] &&
   [ -f "${METRICS_SOURCE}" ] &&
   { [ ! -x "${METRICS_BIN}" ] || [ "${METRICS_SOURCE}" -nt "${METRICS_BIN}" ]; }; then
  METRICS_CLANG_BIN="${RUNNERCTL_CLANG_BIN:-}"
  if [ -z "${METRICS_CLANG_BIN}" ] && command -v clang >/dev/null 2>&1; then
    METRICS_CLANG_BIN="$(command -v clang)"
  fi

  if [ -n "${METRICS_CLANG_BIN}" ]; then
    mkdir -p "$(dirname "${METRICS_BIN}")"
    METRICS_TEMP_PATH="$(mktemp "$(dirname "${METRICS_BIN}")/.runnerctl-procstats.XXXXXX")"
    if "${METRICS_CLANG_BIN}" \
      -O2 \
      -std=c11 \
      -Wall \
      -Wextra \
      "${METRICS_SOURCE}" \
      -o "${METRICS_TEMP_PATH}"; then
      chmod u+x "${METRICS_TEMP_PATH}"
      mv "${METRICS_TEMP_PATH}" "${METRICS_BIN}"
    else
      rm -f "${METRICS_TEMP_PATH}"
      echo "warning: disk I/O metrics helper could not be built" >&2
    fi
  else
    echo "warning: clang is unavailable; disk I/O metrics will be disabled" >&2
  fi
fi

if [ -x "${METRICS_BIN}" ]; then
  export RUNNER_PROCSTATS_BIN="${METRICS_BIN}"
fi

if [ "${1:-}" = "stats" ]; then
  shift
  exec "${NODE_BIN}" "${SCRIPT_DIR}/runnerctl-app/bin/runnerctl-stats.mjs" "$@"
fi

exec "${NODE_BIN}" "${SCRIPT_DIR}/runnerctl-app/bin/runnerctl-dashboard.mjs" "$@"
